{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/AvaloniaLSP/AvaloniaLSP.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Only Extension",
      "command": "npm",
      "args": ["run", "compile"],
      "type": "shell",
      "problemMatcher": "$tsc-watch",
      "options": {
        "cwd": "${workspaceFolder}/src/AxamlLive"
      }
    },
    {
      "label": "Build Extension",
      "command": "npm",
      "args": ["run", "compile"],
      "type": "shell",
      "problemMatcher": "$tsc-watch",
      "options": {
        "cwd": "${workspaceFolder}/src/AxamlLive"
      },
      "dependsOn": ["Build LSP Server", "Build Solution Parser"]
    },
    {
      "label": "Build LSP Server",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/AvaloniaLSP/AvaloniaLanguageServer/AvaloniaLanguageServer.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary",
        "/property:Configuration=Release",
        "--output",
        "${workspaceFolder}/src/AxamlLive/avaloniaServer"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Solution Parser",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/SolutionParser/SolutionParser.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary",
        "/property:Configuration=Release",
        "--output",
        "${workspaceFolder}/src/AxamlLive/solutionParserTool"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Package Extension",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/package.sh",
        "${workspaceFolder}/output/" //package directory
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/AxamlLive" //working directory
      },
      "dependsOn": ["Build Extension"]
    }
  ]
}
