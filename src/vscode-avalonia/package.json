{
  "name": "vscode-avalonia-community",
  "displayName": "Avalonia for VSCode (Community)",
  "description": "Community-maintained MIT Avalonia tools for VS Code: AXAML completion and live previewer",
  "publisher": "AvaloniaCommunity",
  "version": "0.1.0",
  "license": "MIT",
  "preview": true,
  "qna": "false",
  "sponsor": {
    "url": "https://github.com/sponsors/AvaloniaUI"
  },
  "icon": "./media/icon.png",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "Avalonia",
    "AvaloniaUI"
  ],
  "galleryBanner": {
    "color": "#161C2D",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/AvaloniaUI/AvaloniaVSCode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AvaloniaUI/AvaloniaVSCode"
  },
  "activationEvents": [
    "workspaceContains:**/*.axaml",
    "onLanguage:axaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "[Open a folder](command:vscode.openFolder) containing an Avalonia project, or create a new one.\n[Create Avalonia Project](command:avalonia.newProject)"
      }
    ],
    "languages": [
      {
        "id": "AXAML",
        "aliases": [
          "Avalonia XAML",
          "axaml",
          "AXAML"
        ],
        "extensions": [
          ".axaml",
          ".axml"
        ],
        "configuration": "./AXAML.language-configuration.json",
        "icon": {
          "dark": "./media/xaml-dark.svg",
          "light": "./media/xaml-light.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "AXAML",
        "scopeName": "source.AXAML",
        "path": "./AXAML.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "avalonia.createPreviewerAssets",
        "title": "Build project and reload preview",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.showPreviewToSide",
        "title": "Show preview",
        "category": "Avalonia",
        "icon": "$(open-preview)"
      },
      {
        "command": "avalonia.restartPreviewer",
        "title": "Restart previewer",
        "category": "Avalonia",
        "icon": "$(refresh)"
      },
      {
        "command": "avalonia.selectSolution",
        "title": "Select solution",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.newProject",
        "title": "Create a new Avalonia Project",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.newItem",
        "title": "New Avalonia Item…",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.selectPreviewerHost",
        "title": "Select previewer host project",
        "category": "Avalonia"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == AXAML",
          "command": "avalonia.showPreviewToSide",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "avalonia.showPreviewToSide",
          "when": "resourceLangId == AXAML"
        }
      ],
      "explorer/context": [
        {
          "command": "avalonia.newItem",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": [
      {
        "title": "Avalonia",
        "type": "object",
        "properties": {
          "axaml.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "messages",
            "description": "Traces the communication between VS Code and the language server."
          },
          "avalonia.previewer.updateDelay": {
            "type": "number",
            "default": 300,
            "minimum": 0,
            "description": "Delay in milliseconds before unsaved AXAML edits are sent to the previewer."
          },
          "avalonia.previewer.buildIfNeeded": {
            "type": "boolean",
            "default": true,
            "description": "Automatically build the project when the previewer needs build output that does not exist yet."
          },
          "avalonia.previewer.defaultZoom": {
            "type": "number",
            "default": 1,
            "minimum": 0.25,
            "maximum": 4,
            "description": "Initial zoom factor of the previewer (1 = 100%). Use the -/+ buttons or Ctrl+Wheel in the preview to change it."
          },
          "avalonia.previewer.hostProject": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "description": "Executable project (name or path) that hosts the previewer, e.g. a test host for plugin libraries. Empty: the executable that references the file (Desktop head preferred). The \"Select previewer host project\" command overrides this per workspace."
          }
        }
      }
    ],
    "snippets": [
      {
        "language": "csharp",
        "path": "./csharp.json"
      }
    ],
    "configurationDefaults": {
      "explorer.fileNesting.patterns": {
        "*.axaml": "${capture}.axaml.cs, ${capture}.axaml.fs"
      }
    }
  },
  "scripts": {
    "install:all": "yarn install",
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "e2e": "node ./out/test/e2e/runE2E.js"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.79.0",
    "@types/vscode-webview": "^1.57.1",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vscode/test-electron": "^2.2.3",
    "eslint": "^8.34.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.33",
    "@vscode/webview-ui-toolkit": "^1.2.2",
    "@xmldom/xmldom": "^0.8.10",
    "bson": "^5.4.0",
    "fs-extra": "^11.1.1",
    "glob": "^8.1.0",
    "portfinder": "^1.0.32",
    "strongly-typed-events": "^3.0.11",
    "vscode-languageclient": "^8.1.0",
    "xpath": "^0.0.32"
  },
  "extensionDependencies": [
    "ms-dotnettools.vscode-dotnet-runtime"
  ],
  "extensionKind": [
    "workspace"
  ]
}
