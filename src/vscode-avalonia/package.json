{
  "name": "vscode-avalonia-community",
  "displayName": "Avalonia for VSCode (Community)",
  "description": "Community-maintained MIT Avalonia tools for VS Code: AXAML completion and live previewer",
  "publisher": "AvaloniaCommunity",
  "version": "0.1.0",
  "license": "MIT",
  "preview": true,
  "qna": "false",
  "sponsor": {
    "url": "https://github.com/sponsors/AvaloniaUI"
  },
  "icon": "./media/icon.png",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "Avalonia",
    "AvaloniaUI"
  ],
  "galleryBanner": {
    "color": "#161C2D",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/AvaloniaUI/AvaloniaVSCode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AvaloniaUI/AvaloniaVSCode"
  },
  "activationEvents": [
    "workspaceContains:**/*.axaml",
    "onLanguage:axaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "[Open a folder](command:vscode.openFolder) containing an Avalonia project, or create a new one.\n[Create Avalonia Project](command:avalonia.newProject)"
      }
    ],
    "languages": [
      {
        "id": "AXAML",
        "aliases": [
          "Avalonia XAML",
          "axaml",
          "AXAML"
        ],
        "extensions": [
          ".axaml",
          ".axml"
        ],
        "configuration": "./AXAML.language-configuration.json",
        "icon": {
          "dark": "./media/xaml-dark.svg",
          "light": "./media/xaml-light.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "AXAML",
        "scopeName": "source.AXAML",
        "path": "./AXAML.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "avalonia.createPreviewerAssets",
        "title": "Build project and reload preview",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.showPreviewToSide",
        "title": "Show preview",
        "category": "Avalonia",
        "icon": "$(open-preview)"
      },
      {
        "command": "avalonia.restartPreviewer",
        "title": "Restart previewer",
        "category": "Avalonia",
        "icon": "$(refresh)"
      },
      {
        "command": "avalonia.selectSolution",
        "title": "Select solution",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.newProject",
        "title": "Create a new Avalonia Project",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.newItem",
        "title": "New Avalonia Item…",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.selectPreviewerHost",
        "title": "Select previewer host project",
        "category": "Avalonia"
      },
      {
        "command": "avalonia.showCodeBehind",
        "title": "Show Code-behind",
        "category": "Avalonia",
        "icon": "$(file-code)"
      },
      {
        "command": "avalonia.showViewModel",
        "title": "Show ViewModel",
        "category": "Avalonia",
        "icon": "$(symbol-class)"
      },
      {
        "command": "avalonia.runProject",
        "title": "Run / Debug Project",
        "category": "Avalonia",
        "icon": "$(debug-alt)"
      },
      {
        "command": "avalonia.installTemplates",
        "title": "Install / Update Avalonia Project Templates",
        "category": "Avalonia"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == AXAML",
          "command": "avalonia.showPreviewToSide",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "avalonia.showPreviewToSide",
          "when": "resourceLangId == AXAML"
        },
        {
          "command": "avalonia.showCodeBehind",
          "when": "editorLangId == AXAML"
        },
        {
          "command": "avalonia.showViewModel",
          "when": "editorLangId == AXAML"
        }
      ],
      "explorer/context": [
        {
          "command": "avalonia.newItem",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "avalonia.showCodeBehind",
          "when": "editorLangId == AXAML",
          "group": "navigation@1"
        },
        {
          "command": "avalonia.showViewModel",
          "when": "editorLangId == AXAML",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": [
      {
        "title": "Avalonia",
        "type": "object",
        "properties": {
          "axaml.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "messages",
            "description": "Traces the communication between VS Code and the language server."
          },
          "avalonia.previewer.updateDelay": {
            "type": "number",
            "default": 300,
            "minimum": 0,
            "description": "Delay in milliseconds before unsaved AXAML edits are sent to the previewer."
          },
          "avalonia.previewer.buildIfNeeded": {
            "type": "boolean",
            "default": true,
            "description": "Automatically build the project when the previewer needs build output that does not exist yet."
          },
          "avalonia.previewer.defaultZoom": {
            "type": [
              "number",
              "string"
            ],
            "default": 1,
            "markdownDescription": "Initial zoom of the previewer: a factor (`1` = 100%) or `\"fitAll\"` / `\"fitWidth\"`. The zoom chosen in the preview toolbar is remembered per preview."
          },
          "avalonia.previewer.hostProject": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "description": "Executable project (name or path) that hosts the previewer, e.g. a test host for plugin libraries. Empty: the executable that references the file (Desktop head preferred). The \"Select previewer host project\" command overrides this per workspace."
          },
          "avalonia.previewer.defaultThemeVariant": {
            "type": "string",
            "enum": [
              "Default",
              "Light",
              "Dark"
            ],
            "default": "Default",
            "description": "Theme variant the previewer starts with. Default uses the application theme."
          },
          "avalonia.previewer.defaultFormFactor": {
            "type": "string",
            "enum": [
              "default",
              "desktop",
              "laptop",
              "phone",
              "phoneSmall",
              "phoneLarge",
              "tablet",
              "tabletLarge"
            ],
            "default": "default",
            "description": "Form factor (device size) the previewer starts with. default uses the design size of the XAML (d:DesignWidth/Height)."
          },
          "avalonia.previewer.defaultFormFactorRotated": {
            "type": "boolean",
            "default": false,
            "description": "Start with the form factor rotated."
          },
          "avalonia.previewer.enableInput": {
            "type": "boolean",
            "default": true,
            "description": "Forward mouse and keyboard input to the previewed UI (toggle with the 🖱 button)."
          },
          "avalonia.previewer.fpsLimit": {
            "type": "number",
            "default": 30,
            "minimum": 0,
            "description": "Maximum frames per second of the previewer (animations). 0 = unlimited. Lower values reduce CPU usage."
          },
          "avalonia.previewer.maxRenderScale": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 8,
            "description": "Maximum render scale when zoomed in. The preview is rendered at zoom × screen scale up to this value, so zooming stays sharp; lower values keep high zoom levels fast."
          },
          "avalonia.previewer.autoOpen": {
            "type": "boolean",
            "default": false,
            "description": "Open the previewer automatically when an .axaml file is opened."
          },
          "avalonia.previewer.syncWithLaunchConfig": {
            "type": "boolean",
            "default": false,
            "description": "Use the project started by the launch configuration (.vscode/launch.json, coreclr program or dotnet projectPath) as the previewer host, unless a host project is selected explicitly."
          },
          "avalonia.showStyleAdornments": {
            "type": "boolean",
            "default": true,
            "description": "Show a 🎨 badge after elements matched by a Style declared in the same file. Hover the badge to see the selectors."
          },
          "avalonia.editor.attributeQuoteStyle": {
            "type": "string",
            "enum": [
              "double",
              "single"
            ],
            "default": "double",
            "description": "Quotes used for attribute values written by completions and the formatter."
          },
          "avalonia.formatting.attributeWrapping": {
            "type": "string",
            "enum": [
              "none",
              "alignWithFirst",
              "indent"
            ],
            "default": "alignWithFirst",
            "enumDescriptions": [
              "Keep attributes on one line",
              "Continuation lines aligned with the first attribute",
              "Each attribute on its own line, indented one level"
            ],
            "description": "How to wrap attributes when an element has more than avalonia.formatting.attributeWrapThreshold attributes."
          },
          "avalonia.formatting.attributeWrapThreshold": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "description": "Wrap attributes when an element has more than this many attributes. 0 disables wrapping."
          },
          "avalonia.formatting.markupExtensionArgWrapThreshold": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "description": "Wrap markup extension arguments ({Binding ...}) onto separate lines when there are more than this many. 0 disables."
          },
          "avalonia.formatting.collapseBlankLines": {
            "type": "boolean",
            "default": true,
            "description": "Collapse multiple consecutive blank lines into one when formatting."
          }
        }
      }
    ],
    "snippets": [
      {
        "language": "csharp",
        "path": "./csharp.json"
      }
    ],
    "configurationDefaults": {
      "explorer.fileNesting.patterns": {
        "*.axaml": "${capture}.axaml.cs, ${capture}.axaml.fs"
      }
    },
    "keybindings": [
      {
        "command": "avalonia.showCodeBehind",
        "key": "f7",
        "when": "editorLangId == AXAML"
      },
      {
        "command": "avalonia.showViewModel",
        "key": "shift+f7",
        "when": "editorLangId == AXAML"
      }
    ]
  },
  "scripts": {
    "install:all": "yarn install",
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "e2e": "node ./out/test/e2e/runE2E.js",
    "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.79.0",
    "@types/vscode-webview": "^1.57.1",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vscode/test-electron": "^2.2.3",
    "eslint": "^8.34.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.33",
    "@vscode/webview-ui-toolkit": "^1.2.2",
    "@xmldom/xmldom": "^0.8.10",
    "bson": "^5.4.0",
    "fs-extra": "^11.1.1",
    "glob": "^8.1.0",
    "strongly-typed-events": "^3.0.11",
    "vscode-languageclient": "^8.1.0",
    "xpath": "^0.0.32"
  },
  "extensionDependencies": [
    "ms-dotnettools.vscode-dotnet-runtime"
  ],
  "extensionKind": [
    "workspace"
  ]
}
